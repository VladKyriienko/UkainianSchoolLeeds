{
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "knip": "knip --no-progress",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mdx,css,html}\" --ignore-path .prettierignore",
    "stripe:login": "stripe login",
    "stripe:listen": "stripe listen --forward-to=localhost:3000/api/webhooks",
    "stripe:fixtures": "stripe fixtures fixtures/stripe-fixtures.json",
    "supabase:link": "bunx supabase@2.78.1 link",
    "supabase:pull": "bunx supabase@2.78.1 db pull",
    "supabase:push": "bunx supabase@2.78.1 db push --linked",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:chromium:fast": "playwright test --project=chromium --grep-invert \"Admin User Management\" && playwright test tests/admin-user-management-isolated.spec.ts --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=\"Mobile Chrome\" --project=\"Mobile Safari\"",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:install": "playwright install",
    "test:clean": "rm -rf test-results playwright-report",
    "db:start": "bunx supabase@2.78.1 start",
    "db:stop": "bunx supabase@2.78.1 stop",
    "db:status": "bunx supabase@2.78.1 status",
    "db:restart": "bunx supabase@2.78.1 stop && bunx supabase@2.78.1 start",
    "db:reset": "bunx supabase@2.78.1 db reset",
    "db:diff": "drizzle-kit generate",
    "db:migrate": "bunx supabase@2.78.1 db push --local --include-all",
    "db:generate-types": "bunx supabase@2.78.1 gen types typescript --local --schema public > lib/supabase/types.ts",
    "db:studio": "drizzle-kit studio"
  },
