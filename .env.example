# Public site URL used in auth redirects and Supabase invite / magic-link emails (`redirectTo`).
# In production set this to your real HTTPS origin, e.g. https://your-school.com
# Wrong or missing value causes invite emails to link to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

SUPABASE_AUTH_EXTERNAL_GITHUB_REDIRECT_URI="http://127.0.0.1:44321/auth/v1/callback"
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
